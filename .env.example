# Copia aquest fitxer a .env.local i omple'l. .env.local no es puja mai.

# Projecte Supabase (regió europea). Noms propis ACTS_* perquè la integració
# de Supabase de Vercel no els trepitgi. Es llegeixen en temps d'execució.
ACTS_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clau pública (anon / publishable). Pot ser pública perquè l'RLS la conté.
ACTS_SUPABASE_ANON_KEY=

# La clau service_role NO es fa servir enlloc d'aquesta app. No l'afegeixis.
